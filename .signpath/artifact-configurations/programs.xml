<?xml version="1.0" encoding="utf-8"?>
<!-- gfgLock.exe and the Explorer extension, signed before the installers are built from them (the
     release workflow's first signing request; SignPath artifact configuration slug "programs"). The
     artifact keeps their paths from the repository root. Each must carry gfgLock's name as its
     product name and the release's version. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file-set product-name="gfgLock" product-version="${version}">
      <include path="dist/gfgLock/gfgLock.exe" />
      <include path="build/shell/gfglock_shell.dll" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
